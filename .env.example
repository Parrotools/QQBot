# ========= OneBot / NoneBot =========
# NoneBot 驱动：FastAPI（提供反向 WebSocket 服务端）
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
# OneBot 11 access token，必须与 NapCat 侧配置的完全一致
ONEBOT_ACCESS_TOKEN=your-onebot-token

# ========= LLM（任何 OpenAI Compatible API）=========
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=60
# 采样温度（越高越随机，默认 0.7）
LLM_TEMPERATURE=0.7
# 不调用 LLM 的交互回复等待秒数（默认 2；设为 0 关闭）
NON_LLM_REPLY_DELAY_SECONDS=2

# ========= 人格 =========
# YAML 人格配置路径；相对路径以项目根目录为准
PERSONALITY_FILE=app/personality/rumi.yaml
# 主人真实 QQ 号；优先使用此项。留空且只有一个 ADMIN_QQ_IDS 时兼容性回退到该管理员
OWNER_QQ_ID=
# 主人的称呼（关系注入使用，默认 Parrotools）
OWNER_NAME=Parrotools

# ========= 会话 =========
# 上下文最大历史消息条数（user+assistant 合计）
MAX_CONTEXT_MESSAGES=20
# 群聊是否全员共享同一个上下文（默认 false：群内每个成员独立上下文）
GROUP_SHARED_CONTEXT=false

# ========= 网页 =========
# off: 不自动读取 URL | mentioned: 仅被@/私聊/明确命令时读取 | all: 检测到 URL 就处理
URL_AUTO_SUMMARY_MODE=mentioned
# 单页最大下载字节数（默认 4MB）
MAX_WEBPAGE_BYTES=4194304
WEB_FETCH_TIMEOUT_CONNECT=10
WEB_FETCH_TIMEOUT_READ=30
WEB_SUMMARY_CHUNK_CHARS=4000
WEB_SUMMARY_MAX_CHUNKS=8
# 同一 URL 抓取结果缓存秒数（0 = 关闭缓存）
WEB_CACHE_TTL_SECONDS=600
# 普通抓取无正文时是否允许 Playwright fallback（需自行 pip install .[playwright]）
ENABLE_PLAYWRIGHT=false

# ========= 权限与群发 =========
# 管理员 QQ 号，逗号分隔
ADMIN_QQ_IDS=123456789
MAX_BROADCAST_RECIPIENTS=20
SEND_RATE_LIMIT_PER_SECOND=1
# 主动通知投递：失败后写入 SQLite 队列并重试
OUTBOUND_MAX_ATTEMPTS=3
OUTBOUND_RETRY_DELAY_SECONDS=30
OUTBOUND_QUEUE_POLL_SECONDS=1
OUTBOUND_LEASE_SECONDS=60
BROADCAST_REQUIRE_CONFIRM=true
BROADCAST_CONFIRM_TTL_SECONDS=300

# ========= 并发 =========
MAX_CONCURRENT_WEB_TASKS=3
MAX_CONCURRENT_LLM_TASKS=5

# ========= 定时任务 =========
SCHEDULER_TIMEZONE=Asia/Shanghai
# GitHub API token（可选；提高 API 速率上限）
GITHUB_TOKEN=
# GitHub 仓库轮询频率，5 段 cron；留空关闭自动检查
GITHUB_CHECK_CRON=0 * * * *
# 日报发送时间，5 段 cron；留空关闭自动日报
DAILY_REPORT_CRON=0 23 * * *

# ========= 数据 =========
DATABASE_PATH=data/bot.db
LOG_LEVEL=INFO
